}

.lva-kpi-card {
  border-radius: 8px;
  padding: 20px 22px;
  color: #ffffff !important;
  display: flex;
  flex-direction: column;
}

.lva-kpi-card .eyebrow,
.lva-kpi-card .kpi-value,
.lva-kpi-card .kpi-delta {
