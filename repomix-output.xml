<file path="src/pages/Landing.css">
.landing {
  min-height: 100vh;
}

.landing-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 40px;
  border-bottom: 1px solid var(--border);
}

.landing-brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.landing-brand-name {
  font-family: var(--font-voice);
  font-size: 18px;
}

.landing-nav-links {
  display: flex;
  gap: 28px;
  font-size: 13.5px;
  color: var(--text-secondary);
}

.landing-nav-link {
  cursor: pointer;
}

.landing-hero {
  max-width: 1080px;
  margin: 0 auto;
  padding: 80px 40px 40px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
}

.landing-eyebrow {
  font-family: var(--font-mono);
  font-size: 11.5px;
