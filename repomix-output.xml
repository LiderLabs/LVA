}

@media (max-width: 768px) {
  .shared-all-widgets-grid, .lva-charts-grid {
    grid-template-columns: 1fr !important;
  }
  .shared-focus-layout {
    flex-direction: column;
  }
  .shared-live-thumbnails {
    width: 100%;
    flex-direction: row;
    height: 160px;
  }
}
